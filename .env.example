# Copy to .env and fill in. Never commit real values.
DATABASE_URL="postgresql://USER@localhost:5432/policy_admin_dev"
# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=""

# Stripe test mode. Keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the webhook endpoint at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# DocuSign developer sandbox. From https://admindemo.docusign.com/apps-and-keys
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
# The app's RSA private key, base64-encoded onto one line.
# Locally you can instead save the key as docusign_private.pem in this folder.
DOCUSIGN_PRIVATE_KEY_BASE64=""
